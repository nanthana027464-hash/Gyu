-- โหลด Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- สร้างหน้าต่างหลัก
local Window = Rayfield:CreateWindow({
    Name = "OP Break And Steal an Egg",
    LoadingTitle = "Loading Script...",
    LoadingSubtitle = "by Rayfield UI",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "EggStealerConfig",
        FileName = "SaveSettings"
    },
    KeySystem = false -- ไม่ใช้ระบบ Key
})

-- สร้าง Tab Main
local MainTab = Window:CreateTab("Main", 4483362458) -- 4483362458 คือ ID ไอคอน

---------------------------------------------------------------------------
-- SYSTEM 1: AUTO BREAK
---------------------------------------------------------------------------
MainTab:CreateSection("⚒️ Auto Break System")

-- ตัวแปรเก็บค่า
_G.AutoBreak = false
_G.BreakFilter = {}

-- Toggle สำหรับเปิด/ปิด Auto Break
local BreakToggle = MainTab:CreateToggle({
    Name = "Auto Break Status",
    CurrentValue = false,
    Flag = "AutoBreakToggle",
    Callback = function(Value)
        _G.AutoBreak = Value
        if _G.AutoBreak then
            task.spawn(function()
                while _G.AutoBreak do
                    task.wait(0.5) -- ความไว (ปรับได้)
                    
                    -- [ใส่สคริปต์ตีไข่ (FireServer) ของเกมตรงนี้]
                    -- ตัวอย่าง:
                    -- if table.find(_G.BreakFilter, "Secret") then ... end
                    
                end
            end)
        end
    end,
})

-- Dropdown สำหรับเลือก Rarity (เลือกได้หลายอัน)
local BreakDropdown = MainTab:CreateDropdown({
    Name = "Break Rarity Filter",
    Options = {"Secret", "Celestial", "Inferno"},
    CurrentOption = {},
    MultipleOptions = true, -- เปิดให้เลือกหลายตัวเลือก
    Flag = "BreakFilterDropdown",
    Callback = function(Options)
        _G.BreakFilter = Options
    end,
})

